generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  INVALID
  VALID
  CALLBACK
  ENQUIRY
}

enum PayMethod {
  CASH
  ONLINE
}

enum OrderStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum SourcePlatform {
  WATTSAPP
  B_P
  CALLCENTER
  OTHER
}

enum Services{
  CLEANING
  ELECTRIC
  CAR_WASH
  PLUMBING
  NA
}
//Full Deep Cleaning-  FDC
//Lite cleaning -      LC

//WC_FDC
//WC_LC
//1_BHK_FDC
//2_BHK_FDC
//Plumbing

//PVC 
//PSR
//WLR

// ELECTRIC
// WS
// ES
// ER

// CWS
// CIS
// CD

model Lead {
  id          String          @id @default(uuid())
  name        String?
  phone       String          @unique
  email       String?
  lead_status LeadStatus?
  source      SourcePlatform?
  comments    String?
  address     String?
  pincode     String?
  orders      Order[] // A lead can have many orders
  createdAt   DateTime        @default(now())
}

model Order {
  orderId String @id @default(uuid())
  leadId  String

  lead     Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service  String?  //WCFDC||WS
  subservice String?
  date     DateTime
  revenue  Float           @default(0)
  vendor   Float           @default(0)
  profit   Float           @default(0) // Revenue-Vendor
  status   OrderStatus? // Ensure `OrderStatus` enum is defined
  payment  PayMethod       @default(CASH)
  discount Float           @default(0)

  createdAt DateTime @default(now())
}




