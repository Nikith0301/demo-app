generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  INVALID
  VALID
  CALLBACK
  ENQUIRY
}

enum OrderStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum SourcePlatform {
  WATTSAPP
  B_P
  CALLCENTER
  OTHER
}




model Customer {
  id          String         @id @default(uuid())
  name        String?
  phone       String         @unique
  email       String?
  lead_status LeadStatus?
  source      SourcePlatform?
  comments    String?

  orders      Order[]        // 👈 A customer can have many orders
}

model Order {
  order_id    String         @id @default(uuid())
  service     String
  amount      Float?
  status      OrderStatus?

  customer_id String         // 👈 FK to Customer
  customer    Customer       @relation(fields: [customer_id], references: [id],onDelete:Cascade ) // 👈 Each order has exactly one customer
}



